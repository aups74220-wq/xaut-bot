# ──────────────────────────────────────────────
# XAUT/USDT Forex Factory Trading Signal Bot
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat/channel ID (use @username or numeric ID)
ADMIN_CHAT_ID=your_chat_id_here

# How often to poll Forex Factory calendar (seconds, default 90)
POLL_INTERVAL_SECONDS=90

# Optional: proxy for Forex Factory requests (e.g. http://user:pass@host:port)
# Leave empty if not needed
HTTP_PROXY=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
